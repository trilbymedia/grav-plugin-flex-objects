{# flex-objects/page.html.twig #}

{%- set options = options ?? {} %}
{%- set flex = grav.get('flex_objects') %}
{%- set list = list ?? options.list ?? (options.directories ?? flex.defaultDirectories())|keys %}

{#- The stylesheet and List.js go in their own groups and are written out right
    here rather than left to the theme. On a theme whose asset block is not
    deferred, the head has already been rendered by the time page content runs,
    so head-group assets never reach the page. List.js cannot move to 'bottom'
    instead: collection templates call `new List()` in an inline script, which
    needs it loaded first. #}
{%- if page_assets.css ?? config.get('plugins.flex-objects.built_in_css') ?? true %}
    {% if assets.css('flex-objects', {}, false) is empty %}
        {% do assets.addCss('plugin://flex-objects/css/site.css', { 'group': 'flex-objects' }) %}
        {{ assets.css('flex-objects', {}, false)|raw }}
    {% endif %}
{% endif %}
{%- if page_assets.jss ?? true %}
    {% if assets.js('flex-objects', {}, false) is empty %}
        {% do assets.addJs('plugin://flex-objects/js/list.min.js', { 'group': 'flex-objects' }) %}
        {{ assets.js('flex-objects', {}, false)|raw }}
    {% endif %}
{% endif %}

{%- if type %}
    {%- set options = options.directories[type] ?? options %}

    {%- if type not in list %}
        {# Display error page #}
        {% include 'flex-objects/views/404.html.twig' %}

    {%- elseif id %}
        {% set options = options.object ?? options %}

        {# Display specified object #}
        {% include 'flex-objects/views/object.html.twig' with { type: type, id: id, options: options } %}

    {%- else %}
        {% set options = options.collection ?? options %}

        {# Display specified directory #}
        {% include 'flex-objects/views/directory.html.twig' with { type: type, options: options } %}
    {%- endif %}

{%- else %}
    {# Display list of directories #}
    {% include 'flex-objects/views/directories.html.twig' with { options: options, list: list } %}
{% endif %}
